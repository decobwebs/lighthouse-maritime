---
// Port call guide: docs/design-reference/05-port-call-guide.html; copy from CONTENT.md "Calling at Nigerian ports".
// Process source: https://nigerianports.gov.ng/responsibility-of-the-shipping-companyagent/
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import DownloadButton from '../components/DownloadButton.astro';

interface Stage {
  n: string;
  phase: string;
  title: string;
  body: string;
  /** "You send" before arrival, "Documents" once in port. */
  listLabel?: 'You send' | 'Documents';
  list?: string;
  who?: string[];
  receive: string;
}

const stages: Stage[] = [
  {
    n: '01', phase: 'Phase 1 · Before arrival', title: 'Nomination and PDA',
    body: 'You appoint Lighthouse as agent. We prepare a proforma disbursement account: an itemised estimate of port dues, pilotage, towage, agency fees and other charges, which you fund before arrival.',
    listLabel: 'You send', list: 'Vessel particulars, ETA, cargo details, purpose of call',
    who: ['Owner / operator', 'Lighthouse'], receive: 'the PDA',
  },
  {
    n: '02', phase: 'Phase 1 · Before arrival', title: 'Pre-arrival',
    body: "We file the Ship Entry Notice with the Nigerian Ports Authority and submit the cargo manifest and stowage plan to Customs to obtain the vessel's rotation number.",
    listLabel: 'You send', list: 'Cargo manifest, stowage plan, IMO number, last ports of call',
    who: ['NPA', 'Customs'], receive: 'arrival checklist',
  },
  {
    n: '03', phase: 'Phase 1 · Before arrival', title: 'Berthing',
    body: "We declare the vessel at the port's berthing meeting, secure the Port Manager's approval and book the vessel's movement.",
    listLabel: 'You send', list: 'Updated ETA and draft',
    who: ['NPA Port Manager', 'Terminal'], receive: 'berth confirmation',
  },
  {
    n: '04', phase: 'Phase 2 · In port', title: 'Arrival',
    body: 'With the provisional bill paid, pilotage and towage bring the vessel safely alongside. Tankers also require naval clearance.',
    listLabel: 'Documents', list: "Provisional bill and receipt, master's declaration, pilotage chit",
    who: ['Pilots', 'Tugs', 'Navy (tankers)'], receive: 'all-fast report',
  },
  {
    n: '05', phase: 'Phase 2 · In port', title: 'Clearance',
    body: "Boarding agencies clear the vessel. We provide each with the master's lists and certificates and accompany Customs officers on board.",
    listLabel: 'Documents', list: 'Crew list, nil lists, port of call list, ISPS certificate',
    who: ['Port Health', 'Immigration', 'Customs', 'NDLEA', 'NAQS', 'NIMASA', 'DSS'], receive: 'clearance confirmed',
  },
  {
    n: '06', phase: 'Phase 2 · In port', title: 'Operations',
    body: 'Cargo is worked with the terminal and stevedores, while we handle crew changes, provisions, spares and any other husbandry needs.',
    listLabel: 'Documents', list: 'Discharge and loading lists, landing tally records',
    who: ['Terminal', 'Stevedores', 'Receivers'], receive: 'daily status report',
  },
  {
    n: '07', phase: 'Phase 3 · Departure', title: 'Sailing',
    body: 'We obtain NIMASA sailing clearance, settle outstanding port charges and book outward pilotage.',
    listLabel: 'Documents', list: 'NIMASA clearance, settled NPA bills',
    who: ['NIMASA', 'NPA', 'Pilots'], receive: 'sailing report',
  },
  {
    n: '08', phase: 'Phase 3 · Departure', title: 'Final account',
    body: 'We issue the final disbursement account, reconciled line by line against the PDA, with receipts for every charge and any balance refunded or invoiced.',
    receive: 'the FDA',
  },
];
const accent = new Set(['01', '08']);
---
<BaseLayout
  title="How a port call works in Nigeria | Lighthouse Maritime Agency"
  description="The eight stages of a Nigerian port call: what happens, which documents you need and what your agent reports at each step."
>
  <PageHero
    slot="hero"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Port call guide' }]}
    eyebrow="Guide · For owners, operators and charterers"
    title="Calling at Nigerian ports,"
    dim="step by step."
    lead="The eight stages of a port call in Nigeria: what happens, which documents are needed, and what Lighthouse reports to you at each point."
  >
    <div slot="aside" class="checklist">
      <p class="t-micro checklist__meta">Last reviewed · [Month 2026]</p>
      <p class="t-h5 checklist__title">Port call checklist</p>
      <p class="checklist__text">Every document in this guide on one page.</p>
      <DownloadButton class="checklist__btn">Download PDF</DownloadButton>
    </div>
  </PageHero>

  <section class="guide" aria-label="The eight stages">
    <div class="container guide__inner">
      <nav class="toc" aria-labelledby="toc-label">
        <p class="label" id="toc-label">In this guide</p>
        <ol role="list" class="toc__list">
          {stages.map((s) => (
            <li>
              <a href={`#stage-${s.n}`} class="toc__link">
                <span class:list={['toc__num', { 'toc__num--accent': accent.has(s.n) }]}>{s.n}</span>
                {s.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="stages">
        {stages.map((s) => (
          <article id={`stage-${s.n}`} class="stage" aria-labelledby={`stage-${s.n}-title`}>
            <p class:list={['stage__num', { 'stage__num--accent': accent.has(s.n) }]} aria-hidden="true">{s.n}</p>
            <div>
              <p class="t-eyebrow stage__phase">{s.phase}</p>
              <h2 class="t-h2 stage__title" id={`stage-${s.n}-title`}>
                <span class="visually-hidden">Stage {s.n}: </span>{s.title}
              </h2>
              <p class="t-body stage__body">{s.body}</p>
              {(s.list || s.who) && (
                <div class="stage__facts">
                  {s.list && (
                    <div class="stage__fact stage__fact--list">
                      <h3 class="label">{s.listLabel}</h3>
                      <p class="t-small">{s.list}</p>
                    </div>
                  )}
                  {s.who && (
                    <div class="stage__fact">
                      <h3 class="label">Who's involved</h3>
                      <ul role="list" class="chips">
                        {s.who.map((w) => <li class="chip">{w}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              )}
              <p class="stage__receive"><span class="stage__dot" aria-hidden="true"></span>You receive: {s.receive}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta bg-lines" aria-labelledby="guide-cta-title">
    <div class="container cta__inner">
      <div class="cta__copy">
        <p class="t-eyebrow cta__eyebrow">Ready when you are</p>
        <h2 class="t-h2 cta__title" id="guide-cta-title">Let us take your vessel through all eight stages.</h2>
      </div>
      <div class="cta__actions">
        <Button href="/request-a-pda">Request a PDA</Button>
        <DownloadButton variant="secondary-light">Download checklist</DownloadButton>
      </div>
    </div>
  </section>

  <div class="note">
    <p class="container t-micro note__text">
      This guide is for general information. Requirements can change; confirm with our desk before arrival.
    </p>
  </div>
</BaseLayout>

<style>
  /* ---------- Hero side card ---------- */
  .checklist {
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
  }
  .checklist__meta { color: var(--on-dark-muted); }
  .checklist__title { margin-top: 10px; }
  .checklist__text { margin-top: 6px; font-size: 14px; line-height: 1.6; color: var(--on-dark-muted); }
  .checklist :global(.checklist__btn) { margin-top: 16px; }

  .label {
    margin-bottom: 10px;
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--label);
  }

  /* ---------- Contents + stages ---------- */
  .guide { border-bottom: 1px solid var(--line); }
  .guide__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px 72px;
    padding-block: 40px 120px;
  }

  .toc {
    position: sticky;
    top: 24px;
    flex: 1 1 260px;
    max-width: 300px;
    padding-top: 56px;
  }
  .toc__list { border-top: 2px solid var(--navy); }
  .toc__link {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .toc__link:hover { color: var(--red); }
  .toc__num { width: 22px; flex: none; font-weight: 700; color: var(--label); }
  .toc__num--accent { color: var(--red); }

  .stages { flex: 999 1 620px; min-width: 0; }
  .stage {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 24px 32px;
    padding-block: 56px;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 24px;
  }
  .stage:last-child { border-bottom: 0; }
  .stage__num {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--line-strong);
  }
  .stage__num--accent { color: var(--red); }
  .stage__phase { font-size: 12px; color: var(--label); }
  .stage__title { margin-top: 10px; }
  .stage__body { margin-top: 16px; color: var(--muted); }
  .stage__facts { display: flex; flex-wrap: wrap; gap: 32px 56px; margin-top: 28px; }
  .stage__fact { flex: 1 1 200px; }
  .stage__fact--list { flex-basis: 240px; }

  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.4;
  }

  .stage__receive {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding: 8px 14px;
    border-radius: 20px;
    background: var(--ok-bg);
    color: var(--ok);
    font-size: 14px;
    font-weight: 600;
  }
  .stage__dot { width: 7px; height: 7px; flex: none; border-radius: 50%; background: var(--ok-dot); }

  /* ---------- CTA + note ---------- */
  .cta { border-bottom: 1px solid var(--line); }
  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px 64px;
    padding-block: 96px;
  }
  .cta__copy { max-width: 640px; }
  .cta__eyebrow { color: var(--red); }
  .cta__title { margin-top: 16px; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 14px; }

  .note__text { padding-block: 24px; color: var(--muted); }

  /* ---------- Tablet/phone: contents becomes a scrollable chip row ---------- */
  @media (max-width: 959px) {
    .guide__inner { display: block; padding-top: 0; }
    .toc {
      position: static;
      max-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding: 16px var(--gutter);
      border-bottom: 1px solid var(--line);
    }
    .toc .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .toc__list {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      border-top: 0;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .toc__list::-webkit-scrollbar { display: none; }
    .toc__link {
      gap: 8px;
      min-height: 44px;
      padding: 0 14px;
      border: 1px solid var(--line-strong);
      border-radius: var(--r-pill);
      font-size: 14px;
      white-space: nowrap;
    }
    .toc__num { width: auto; }
  }

  @media (max-width: 720px) {
    .stage { grid-template-columns: 1fr; gap: 12px; padding-block: 40px; }
    .stage__num { font-size: 40px; }
  }

  @media (max-width: 599px) {
    .guide__inner { padding-bottom: 64px; }
    .stage { scroll-margin-top: 16px; }
    .stage__facts { gap: 20px; margin-top: 20px; }
    .stage__receive { margin-top: 20px; }
    .cta__inner { padding-block: 64px; gap: 24px; }
    .cta__title { margin-top: 12px; }
    .cta__actions { flex-direction: column; width: 100%; gap: 10px; }
    .cta__actions > :global(*) { width: 100%; border-radius: var(--r-input); }
  }
</style>
