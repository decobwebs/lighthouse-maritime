---
// Home: docs/design-reference/01-home-desktop.html + 02-home-phone.html; copy from CONTENT.md "Home".
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StatBar from '../components/StatBar.astro';
import CertifiedStrip from '../components/CertifiedStrip.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PromiseRows from '../components/PromiseRows.astro';
import ServiceBento from '../components/ServiceBento.astro';
import PhaseTimeline from '../components/PhaseTimeline.astro';
import PortColumns from '../components/PortColumns.astro';
import AudienceCards from '../components/AudienceCards.astro';
import CertifiedList from '../components/CertifiedList.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';
import aboutTug from '../assets/images/about-tug.jpg';
import ctaNight from '../assets/images/cta-night.jpg';

const stats = [
  { value: '24/7', label: 'Operations desk, every day of the year' },
  { value: '9', accent: '+', label: 'Nigerian ports and offshore terminals' },
  { value: '8', label: 'Reporting points on every port call' },
  { value: '[X]', unit: 'hrs', label: 'PDA turnaround after a complete request' },
];

const promises = [
  { title: 'Accurate PDAs', text: 'A full port cost estimate within [X hours], reconciled line by line in the final account.' },
  { title: 'Clear updates', text: 'Status reports at every stage of the call, by email and WhatsApp.' },
  { title: 'One accountable contact', text: 'A named officer for each vessel, backed by a 24/7 operations desk.' },
];
---
<BaseLayout
  title="Ship agency at every Nigerian port | Lighthouse Maritime Agency"
  description="Port agency, husbandry, clearance and vessel supply at every Nigerian port. Accurate PDAs, clear updates and a 24/7 operations desk in Apapa, Lagos."
  header="overlay"
  localBusiness
>
  <Hero slot="hero" />

  <StatBar stats={stats} />
  <CertifiedStrip />

  <!-- 01 — About -->
  <section id="about" class="section bg-glow" aria-labelledby="about-title">
    <div class="container about">
      <div class="about__media">
        <div class="about__photo">
          <Picture
            src={aboutTug}
            formats={['avif', 'webp']}
            widths={[400, 600, 800, 1100]}
            sizes="(max-width: 959px) 100vw, 560px"
            alt="A harbour tug under way"
            class="about__img"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="about__card">
          <p class="t-eyebrow about__card-kicker">Head office</p>
          <p class="t-h5 about__card-title">5 Bornu Crescent, Apapa, Lagos</p>
          <p class="t-micro about__card-meta">Incorporated 2024 · {SITE.rc}</p>
        </div>
      </div>
      <div class="about__copy">
        <SectionHeading
          id="about-title"
          eyebrow="01 — About Lighthouse"
          title="A ship agency built on"
          dim="clarity and accountability."
        />
        <p class="t-body about__text">
          Lighthouse Maritime Agency supports owners, operators and charterers at every Nigerian port. We
          keep each call simple to follow: what it will cost, where it stands and who is responsible.
        </p>
        <div class="about__rows">
          <PromiseRows items={promises} />
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — Services -->
  <section id="services" class="section services" aria-labelledby="services-title">
    <div class="services__dots bg-dots" aria-hidden="true"></div>
    <div class="container services__inner">
      <SectionHeading
        id="services-title"
        eyebrow="02 — Services"
        title="Everything your vessel needs"
        dim="in a Nigerian port."
      >
        <p class="t-body">
          Appoint us for a single task or the whole call. Each service is handled by the same operations
          desk and reported the same way.
        </p>
      </SectionHeading>
      <div class="block-gap">
        <ServiceBento />
      </div>
    </div>
  </section>

  <!-- 03 — How a port call works -->
  <section id="process" class="section section--dark bg-rings on-dark" aria-labelledby="process-title">
    <div class="container">
      <SectionHeading
        id="process-title"
        eyebrow="03 — How a port call works"
        title="You always know where your vessel stands,"
        dim="from nomination to final account."
        maxWidth={700}
        onDark
      >
        <Button href="/port-call-guide" variant="secondary-dark" class="process__guide">Read the port call guide</Button>
      </SectionHeading>
      <div class="process__timeline">
        <PhaseTimeline />
      </div>
    </div>
  </section>

  <!-- 04 — Port coverage -->
  <section id="ports" class="section" aria-labelledby="ports-title">
    <div class="container">
      <SectionHeading id="ports-title" eyebrow="04 — Port coverage" title="Every Nigerian port," dim="one point of contact.">
        <p class="t-body">From our Apapa head office, one operations desk manages your call wherever the vessel berths.</p>
      </SectionHeading>
      <div class="block-gap">
        <PortColumns />
      </div>
    </div>
  </section>

  <!-- 05 — Who we work with -->
  <section class="section bg-lines" aria-labelledby="audience-title">
    <div class="container">
      <SectionHeading
        id="audience-title"
        eyebrow="05 — Who we work with"
        title="Trusted support"
        dim="for every side of shipping."
        maxWidth={720}
      />
      <div class="block-gap">
        <AudienceCards />
      </div>
    </div>
  </section>

  <!-- 06 — Compliance -->
  <section id="compliance" class="section bg-glow" aria-labelledby="compliance-title">
    <div class="container compliance">
      <div class="compliance__copy">
        <SectionHeading
          id="compliance-title"
          eyebrow="06 — Compliance"
          title="Certified by"
          dim="Nigeria's maritime authorities."
        />
        <p class="t-body compliance__text">
          We are certified by the bodies that regulate ports, shipping and oil and gas supply in Nigeria.
          Certificates are shared with clients and procurement teams on request.
        </p>
        <Button href="/contact?enquiry=company-profile" variant="secondary-light" class="compliance__btn">
          Request company profile
        </Button>
      </div>
      <div class="compliance__list">
        <CertifiedList />
      </div>
    </div>
  </section>

  <!-- TODO(brand-photo): cta-night.jpg shows EVERGREEN branding; the client may replace it. -->
  <CtaBanner
    eyebrow="Vessel inbound?"
    title="Let's prepare your port call."
    lead="Send the vessel details and receive a PDA within [X hours], or call the operations desk any time."
    image={ctaNight}
    alt="A container ship alongside under quay cranes at night"
    position="50% 40%"
  >
    <Button href="/request-a-pda">Request a PDA</Button>
    <Button href={SITE.ops.tel} variant="secondary-dark">{SITE.ops.phone}</Button>
  </CtaBanner>
</BaseLayout>

<style>
  .block-gap { margin-top: 64px; }

  /* The dark section's bottom rule would show as a light line; keep it dark. */
  .section--dark { border-bottom-color: var(--deep); }

  /* ---------- 01 About ---------- */
  .about {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 64px 88px;
  }
  .about__media { position: relative; flex: 1 1 460px; min-width: 0; }
  .about__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--navy);
  }
  .about__photo :global(picture),
  .about__photo :global(.about__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .about__photo :global(.about__img) { object-fit: cover; object-position: 48% 50%; }

  .about__card {
    position: absolute;
    right: -24px;
    bottom: 40px;
    max-width: 250px;
    padding: 20px 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-float);
  }
  .about__card-kicker { font-size: 11.5px; color: var(--red); }
  .about__card-title { margin-top: 8px; }
  .about__card-meta { margin-top: 6px; color: var(--muted); }

  .about__copy { flex: 1 1 480px; min-width: 0; }
  .about__text { margin-top: 24px; color: var(--muted); }
  .about__rows { margin-top: 40px; }

  /* ---------- 02 Services ---------- */
  .services { position: relative; }
  .services__dots { position: absolute; inset: 0 0 auto 0; height: 420px; }
  .services__inner { position: relative; }

  /* ---------- 03 Process ---------- */
  .process__timeline { margin-top: 72px; }
  .section--dark :global(.process__guide) { font-size: 15px; padding: 14px 22px; font-weight: 600; }

  /* ---------- 06 Compliance ---------- */
  .compliance {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px 96px;
  }
  .compliance__copy { flex: 1 1 400px; min-width: 0; }
  .compliance__text { margin-top: 24px; color: var(--muted); }
  .compliance__copy :global(.compliance__btn) { margin-top: 36px; font-size: 15px; padding: 15px 24px; font-weight: 600; }
  .compliance__list { flex: 1.3 1 520px; min-width: 0; }

  @media (max-width: 959px) {
    .about__card { right: 16px; }
  }

  @media (max-width: 599px) {
    .block-gap { margin-top: 28px; }
    .process__timeline { margin-top: 32px; }

    /* Phone About: heading first, then a 4:3 photo, then the rows (02-home-phone). */
    .about { flex-direction: column; align-items: stretch; gap: 0; }
    .about__copy { display: contents; }
    .about__copy > :global(.sh) { order: 1; }
    /* Explicit width: in a column flexbox the aspect-ratio photo otherwise sizes to zero height. */
    .about__media { order: 2; flex: none; width: 100%; margin-top: 28px; }
    .about__text { order: 3; }
    .about__rows { order: 4; margin-top: 24px; }
    .about__photo { aspect-ratio: 4 / 3; border-radius: 14px; }
    .about__card { display: none; }

    .section--dark :global(.process__guide) { width: 100%; border-radius: var(--r-input); }
    .compliance { gap: 24px; }
    .compliance__copy :global(.compliance__btn) { width: 100%; margin-top: 24px; }
  }
</style>
