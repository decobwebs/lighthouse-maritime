---
// Service page template: docs/design-reference/04-service-page-port-agency.html.
// One page per entry in src/content/services; copy from CONTENT.md "Service pages".
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE, PORT_REGIONS } from '../../data/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { slug: service.data.slug }, props: { service } }));
}

interface Props {
  service: CollectionEntry<'services'>;
}
const { service } = Astro.props;
const s = service.data;

const all = await getCollection('services');
const related = s.related
  .map((slug) => all.find((entry) => entry.data.slug === slug))
  .filter((entry): entry is CollectionEntry<'services'> => Boolean(entry));

const ports = PORT_REGIONS.flatMap((r) => r.ports);

const included = s.includedHeading;
const whoFor = s.whoForHeading;
const weNeed = s.weNeedHeading;
---
<BaseLayout title={s.meta.title} description={s.meta.description} header="overlay">
  <PageHero
    slot="hero"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: s.title }]}
    eyebrow={s.eyebrow}
    title={s.h1}
    dim={s.h1Dim}
    lead={s.lead}
    image={s.heroImage}
    alt={s.heroAlt}
    position={s.heroPosition}
  >
    <Button href="/request-a-pda">Request a PDA</Button>
    <Button href={SITE.ops.tel} variant="secondary-dark">Call the 24/7 desk</Button>
  </PageHero>

  <!-- What's included -->
  <section class="section bg-white" aria-labelledby="included-title">
    <div class="container split">
      <div class="split__intro" data-reveal>
        <p class="t-eyebrow eyebrow">What's included</p>
        <h2 class="t-h2 sec-title" id="included-title">
          {included.title} <span class="dim">{included.dim}</span>
        </h2>
        {included.body && <p class="t-body sec-body">{included.body}</p>}
      </div>
      <ul role="list" class="ticks" data-reveal>
        {s.included.map((item) => (
          <li class="ticks__item">
            <svg class="ticks__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
            <div>
              <p class="t-h5">{item.title}</p>
              <p class="t-small ticks__text">{item.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section bg-mist" aria-labelledby="who-title">
    <div class="container">
      <div data-reveal>
      <p class="t-eyebrow eyebrow">Who it's for</p>
      <h2 class="t-h2 sec-title who__title" id="who-title">
        {whoFor.title} <span class="dim">{whoFor.dim}</span>
      </h2>
      </div>
      <ol role="list" class="who" data-reveal>
        {s.whoFor.map((item, i) => (
          <li class="who__col">
            <p class="who__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="t-h4 who__name">{item.title}</h3>
            <p class="t-small who__text">{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- What we need from you -->
  <section class="section bg-white" aria-labelledby="need-title">
    <div class="container need">
      <div class="need__photo" data-reveal>
        <Picture
          src={s.needImage}
          formats={['avif', 'webp']}
          widths={[400, 640, 900, 1100]}
          sizes="(max-width: 959px) 100vw, 560px"
          alt={s.needAlt}
          class="need__img"
          style={`object-position: ${s.needPosition}`}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="need__copy" data-reveal>
        <p class="t-eyebrow eyebrow">To get started</p>
        <h2 class="t-h2 sec-title" id="need-title">
          {weNeed.title} <span class="dim">{weNeed.dim}</span>
        </h2>
        {weNeed.body && <p class="t-body sec-body">{weNeed.body}</p>}
        <ol role="list" class="need__list">
          {s.weNeed.map((line, i) => (
            <li><span class="need__num" aria-hidden="true">{i + 1}</span><span class="need__text">{line}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Ports covered -->
  <section class="section ports-strip bg-mist" aria-labelledby="ports-title">
    <div class="container ports">
      <div class="ports__intro" data-reveal>
        <p class="t-eyebrow eyebrow">Ports covered</p>
        <h2 class="t-h2 ports__title" id="ports-title">Available at every Nigerian port.</h2>
      </div>
      <ul role="list" class="chips" data-reveal>
        {ports.map((port, i) => <li class:list={['chip', { 'chip--on': i === 0 }]}>{port}</li>)}
      </ul>
    </div>
  </section>

  <!-- Related services -->
  <section class="section bg-white" aria-labelledby="related-title">
    <div class="container">
      <div class="related__head" data-reveal>
        <div>
          <p class="t-eyebrow eyebrow">Often booked together</p>
          <h2 class="t-h2 related__title" id="related-title">Related services</h2>
        </div>
        <a href="/services" class="related__all">All services <span aria-hidden="true">→</span></a>
      </div>
      <ul role="list" class="related">
        {related.map((r) => (
          <li>
            <ServiceCard
              compact
              href={`/services/${r.data.slug}`}
              code={r.data.code}
              title={r.data.title}
              image={r.data.heroImage}
              alt={r.data.heroAlt}
              position={r.data.heroPosition}
              sizes="(max-width: 959px) 100vw, 400px"
              class="related__card"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand eyebrow="Appoint Lighthouse" title="Get a PDA for your next call." lead="Itemised, explained and with you within [X hours].">
    <Button href="/request-a-pda">Request a PDA</Button>
  </CtaBand>
</BaseLayout>

<style>
  .eyebrow { color: var(--red); }
  .sec-title { margin-top: 18px; }
  .sec-body { margin-top: 22px; color: var(--muted); }

  /* ---------- What's included ---------- */
  .split { display: flex; flex-wrap: wrap; gap: 48px 96px; }
  .split__intro { flex: 1 1 360px; min-width: 0; }
  .ticks {
    flex: 1.5 1 560px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 48px;
    align-content: start;
    border-top: 2px solid var(--navy);
  }
  .ticks__item {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 14px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .ticks__icon { margin-top: 2px; color: var(--red); }
  .ticks__text { margin-top: 4px; color: var(--muted); }

  /* ---------- Who it's for ---------- */
  .who__title { max-width: 680px; }
  .who {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 56px;
    border-top: 1px solid var(--line);
  }
  .who__col { padding: 36px 36px 0; border-right: 1px solid var(--line); }
  .who__col:first-child { padding-left: 0; }
  .who__col:last-child { padding-right: 0; border-right: 0; }
  .who__num {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--line-strong);
  }
  .who__name { margin-top: 16px; }
  .who__text { margin-top: 10px; color: var(--muted); }

  /* ---------- What we need ---------- */
  .need { display: flex; flex-wrap: wrap; align-items: center; gap: 56px 88px; }
  .need__photo {
    position: relative;
    flex: 1 1 440px;
    min-width: 0;
    aspect-ratio: 5 / 4;
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--navy);
  }
  .need__photo :global(picture),
  .need__photo :global(.need__img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .need__photo :global(.need__img) { object-fit: cover; }
  .need__copy { flex: 1 1 460px; min-width: 0; }
  .need__list { margin-top: 32px; border-top: 1px solid var(--line-strong); }
  .need__list li {
    display: flex;
    gap: 18px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line-strong);
  }
  .need__num { width: 24px; flex: none; font-family: var(--font-display); font-weight: 700; color: var(--red); line-height: 1.7; }
  .need__text { font-size: 16.5px; line-height: 1.7; }

  /* ---------- Ports covered ---------- */
  .ports-strip { padding-block: 96px; }
  .ports { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px 80px; }
  .ports__intro { flex: 1 1 340px; }
  .ports__title { margin-top: 16px; font-size: min(var(--fs-h2), 38px); }
  .chips { flex: 2 1 560px; display: flex; flex-wrap: wrap; gap: 10px; }
  .chip {
    padding: 10px 17px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
  }
  .chip--on { background: var(--navy); border-color: var(--navy); color: var(--on-dark); }

  /* ---------- Related ---------- */
  .related__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .related__title { margin-top: 16px; font-size: min(var(--fs-h2), 40px); }
  .related__all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .related__all:hover { text-decoration: underline; }
  .related {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }
  .related :global(.related__card) { height: 340px; min-height: 0; }

  @media (max-width: 959px) {
    .ticks { flex-basis: 100%; }
    .who { grid-template-columns: 1fr; }
    .who__col,
    .who__col:first-child,
    .who__col:last-child { padding: 28px 0; border-right: 0; }
    .who__col:not(:last-child) { border-bottom: 1px solid var(--line); }
    .related { grid-template-columns: 1fr; gap: 14px; }
    .related :global(.related__card) { height: 260px; }
  }

  @media (max-width: 599px) {
    .sec-title { margin-top: 14px; }
    .split { gap: 28px; }
    .ticks { grid-template-columns: 1fr; }
    .ticks__item { padding-block: 18px; }
    .who { margin-top: 32px; }
    .who__col,
    .who__col:first-child,
    .who__col:last-child {
      display: grid;
      grid-template-columns: 52px 1fr;
      align-items: baseline;
      padding: 22px 0;
    }
    .who__num { font-size: 32px; }
    .who__name { margin-top: 0; }
    .who__text { grid-column: 2; margin-top: 6px; }
    .need { gap: 28px; }
    .need__photo { flex-basis: 100%; aspect-ratio: 4 / 3; border-radius: 14px; }
    .need__list { margin-top: 24px; }
    .need__list li { padding-block: 14px; }
    .need__text { font-size: var(--fs-body); }
    .ports-strip { padding-block: 64px; }
    .ports { gap: 24px; }
    .chip { padding: 8px 14px; font-size: 14px; }
    .related { margin-top: 28px; }
    .related :global(.related__card) { height: 200px; }
  }
</style>
