---
// After "Send by email" / "Send on WhatsApp" on /request-a-pda. Copy: CONTENT.md "Request a PDA", thank-you.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SendThanks from '../../components/SendThanks.astro';
import { SITE } from '../../data/site';
---
<BaseLayout
  title="Almost done | Lighthouse Maritime Agency"
  description="Press Send in your email app or WhatsApp to send your PDA request."
  noindex
>
  <PageHero
    slot="hero"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Request a PDA', href: '/request-a-pda' }, { label: 'Send your request' }]}
    title="Request a PDA"
    dim="for your next Nigerian port call."
  />
  <SendThanks
    storageKey="lma-pda-draft"
    refPattern="^LMA-PDA-[0-9]{8}-[A-Z0-9]{4}$"
    lead={`Your email app or WhatsApp should have opened with your request. Please press Send there. If nothing opened, copy your details or call ${SITE.ops.phone}.`}
    startHref="/request-a-pda"
    startLabel="Start a new request"
    mailbox={SITE.ops.mailbox}
  />
</BaseLayout>
