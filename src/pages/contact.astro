---
// Contact: docs/design-reference/07-contact.html; copy from CONTENT.md "Contact".
// No server: the enquiry is checked in the browser (src/lib/contact-rules.ts), confirmed in a "Check
// your details" dialog, then sent from the visitor's own email app or WhatsApp (src/scripts/send-flow.ts).
// The Google map loads only after "Show map".
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CheckDialog from '../components/CheckDialog.astro';
import SendPanel from '../components/SendPanel.astro';
import Email from '../components/Email.astro';
import { SITE } from '../data/site';
import { ENQUIRY_TYPES } from '../lib/contact-rules';

const address = '5 Bornu Crescent, Apapa, Lagos, Nigeria';
const q = encodeURIComponent(address);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${q}`;
const embedUrl = `https://www.google.com/maps?q=${q}&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${q}`;

---
<BaseLayout
  title="Contact | Lighthouse Maritime Agency"
  description="24/7 operations desk +234 806 118 9106. Head office: 5 Bornu Crescent, Apapa, Lagos."
  localBusiness
>
  <div slot="hero">
    <PageHero
      flush
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
      title="Talk to us,"
      dim="day or night."
      lead="Our operations desk is open 24 hours a day. For anything else, our administration team replies within one business day."
    />
    <div class="container desks on-dark">
      <section class="desk" aria-labelledby="desk-ops">
        <p class="t-micro desk__status desk__status--open"><span class="desk__dot" aria-hidden="true"></span>Open now · 24/7</p>
        <h2 class="t-h3 desk__title" id="desk-ops">Operations desk</h2>
        <p class="t-small desk__note">Vessel calls, PDAs, urgent requests.</p>
        <p class="t-body desk__lines">
          <a href={SITE.ops.tel}>{SITE.ops.phone}</a><br />
          <Email mailbox={SITE.ops.mailbox} />
        </p>
      </section>
      <section class="desk" aria-labelledby="desk-admin">
        <p class="t-micro desk__status">Mon–Fri · Business hours</p>
        <h2 class="t-h3 desk__title" id="desk-admin">Administration</h2>
        <p class="t-small desk__note">Tenders, vendor registration, accounts.</p>
        <p class="t-body desk__lines">
          <a href={SITE.admin.tel}>{SITE.admin.phone}</a><br />
          <Email mailbox={SITE.admin.mailbox} />
        </p>
      </section>
      <section class="desk" aria-labelledby="desk-visit">
        <p class="t-micro desk__status">Head office</p>
        <h2 class="t-h3 desk__title" id="desk-visit">Visit us</h2>
        <p class="t-small desk__note">By appointment.</p>
        <address class="t-body desk__lines">5 Bornu Crescent<br />Apapa, Lagos, Nigeria</address>
      </section>
    </div>
  </div>

  <!-- General enquiry -->
  <section class="section enquiry-section bg-white" aria-labelledby="enquiry-title">
    <div class="container enquiry">
      <div class="enquiry__intro">
        <p class="t-eyebrow eyebrow">General enquiry</p>
        <h2 class="enquiry__title" id="enquiry-title" data-split>Send us a message.</h2>
        <p class="t-body enquiry__text">
          For a port cost estimate, use the PDA form instead. It asks for exactly what we need and goes straight to
          the operations desk.
        </p>
        <a href="/request-a-pda" class="pda-link">Go to the PDA form <span aria-hidden="true">→</span></a>
      </div>

      <div class="form-col">
      <form class="form" data-contact-form>
        <div class="form-summary fld--wide" data-summary role="alert" aria-live="assertive" tabindex="-1" hidden></div>
        <div class="fld">
          <label for="c-name">Full name</label>
          <input id="c-name" type="text" name="name" autocomplete="name" required />
        </div>
        <div class="fld">
          <label for="c-company">Company</label>
          <input id="c-company" type="text" name="company" autocomplete="organization" />
        </div>
        <div class="fld">
          <label for="c-email">Work email (optional)</label>
          <input id="c-email" type="email" name="email" autocomplete="email" />
        </div>
        <div class="fld">
          <label for="c-phone">Phone (optional)</label>
          <input id="c-phone" type="tel" name="phone" autocomplete="tel" />
        </div>
        <div class="fld fld--wide">
          <label for="enquiry-type">Enquiry type</label>
          <select name="enquiry" id="enquiry-type">
            {ENQUIRY_TYPES.map((t) => <option value={t.value}>{t.label}</option>)}
          </select>
        </div>
        <div class="fld fld--wide">
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" rows="5" required></textarea>
        </div>
        <div class="form__foot">
          <p class="attach-note">Need to send documents? Attach them in your email app before sending.</p>
          <button type="submit" class="submit" data-js-only>Send message</button>
        </div>
        <noscript>
          <p class="nojs fld--wide">
            To send a message, please email <Email mailbox={SITE.admin.mailbox} /> or call
            <a href={SITE.admin.tel}>{SITE.admin.phone}</a>.
          </p>
        </noscript>
      </form>
      <SendPanel title="Send your message" fallbackHref="/contact" />
      </div>
    </div>
  </section>

  <!-- Map: Google content loads only after the visitor asks for it -->
  <section class="map-section bg-mist" aria-label="Map of our head office">
    <div class="container">
      <div class="map" data-map data-embed={embedUrl} data-reveal>
        <svg class="map__art" viewBox="0 0 1200 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2">
            <path d="M0 120 H1200 M0 300 H1200 M220 0 V460 M560 0 V460 M900 0 V460" />
            <path d="M0 380 C300 360 500 400 760 370 C960 350 1100 380 1200 360" stroke-width="40" stroke-opacity="0.5" />
          </g>
        </svg>
        <div class="map__pin">
          <div class="map__card">
            <p class="t-h4 map__name">Lighthouse Maritime Agency</p>
            <p class="t-micro map__addr">5 Bornu Crescent, Apapa</p>
          </div>
          <svg width="28" height="36" viewBox="0 0 24 32" aria-hidden="true">
            <path d="M12 0C5.4 0 0 5.4 0 12c0 9 12 20 12 20s12-11 12-20C24 5.4 18.6 0 12 0z" fill="var(--red)" />
            <circle cx="12" cy="12" r="4.5" fill="#FFFFFF" />
          </svg>
        </div>
        <div class="map__actions">
          <span class="map__show">
            <a href={mapsUrl} class="map__btn map__btn--light" data-show-map target="_blank" rel="noopener">Show map</a>
            <span class="t-micro map__note" data-map-note>Loading the map shares data with Google.</span>
          </span>
          <a href={directionsUrl} class="map__btn" target="_blank" rel="noopener">Get directions</a>
        </div>
      </div>
    </div>
  </section>

  <CheckDialog />
</BaseLayout>

<script>
  import { validateContact, enquiryLabel } from '../lib/contact-rules';
  import { contactSubject, contactSummary } from '../lib/send';
  import { setupSendFlow } from '../scripts/send-flow';
  import { emailAddress, whatsappDigits, SITE } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const flow = setupSendFlow({
      form,
      kind: 'ENQ',
      storageKey: 'lma-enq-draft',
      fieldLabels: { name: 'Full name', email: 'Work email', phone: 'Phone', message: 'Message' },
      validate: (v) => validateContact(v),
      dialogRows: (v) => [
        ...(v.email?.trim() ? [{ label: 'Email', value: v.email.trim(), big: true }] : []),
        ...(v.phone?.trim() ? [{ label: 'Phone', value: v.phone.trim(), big: true }] : []),
        { label: 'Name', value: v.name.trim() },
        { label: 'Enquiry', value: enquiryLabel(v.enquiry) },
      ],
      summary: (v, _multi, ref) => contactSummary(v, ref),
      subject: (v, ref) => contactSubject(v, ref),
      to: emailAddress(SITE.admin.mailbox),
      cc: emailAddress(SITE.ops.mailbox),
      whatsappDigits: whatsappDigits(),
      thankYouPath: '/contact/thank-you',
    });
    flow.restore();

    // Preselect the enquiry type from ?enquiry= (e.g. "Request company profile" links).
    const select = document.getElementById('enquiry-type') as HTMLSelectElement | null;
    const wanted = new URLSearchParams(window.location.search).get('enquiry');
    if (select && wanted && [...select.options].some((o) => o.value === wanted)) {
      select.value = wanted;
      flow.save();
    }
  }

  // Swap the drawing for the real Google map only on request.
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const trigger = map.querySelector<HTMLAnchorElement>('[data-show-map]');
    trigger?.addEventListener('click', (event) => {
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = map.dataset.embed ?? '';
      frame.title = 'Map: 5 Bornu Crescent, Apapa, Lagos';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.className = 'map__frame';
      map.classList.add('map--live');
      map.prepend(frame);
      trigger.remove();
      map.querySelector('[data-map-note]')?.remove();
      frame.focus();
    });
  });
</script>

<style>
  .eyebrow { color: var(--red); }

  /* ---------- Desks (inside the dark masthead) ---------- */
  .desks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-top: 64px;
  }
  .desk { padding: 36px 36px 56px; border-top: 1px solid var(--on-dark-line); }
  .desk:first-child { padding-left: 0; }
  .desk:last-child { padding-right: 0; }
  .desk + .desk { border-left: 1px solid var(--on-dark-line); }
  .desk__status { display: inline-flex; align-items: center; gap: 8px; color: var(--on-dark-muted); }
  .desk__status--open { color: var(--ok-on-dark); }
  .desk__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok-dot); }
  .desk__title { margin-top: 14px; }
  .desk__note { margin-top: 10px; color: var(--on-dark-muted); }
  .desk__lines { margin-top: 22px; line-height: 2; font-style: normal; overflow-wrap: anywhere; }
  .desk__lines :global(a) { color: var(--on-dark); text-decoration: none; }
  .desk__lines :global(a:hover) { text-decoration: underline; }

  /* ---------- Enquiry ---------- */
  .enquiry-section { padding-block: 112px; }
  .enquiry { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 56px 80px; }
  .enquiry__intro { flex: 1 1 340px; min-width: 0; }
  .enquiry__title {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(32px, 3.6vw, 46px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .enquiry__text { margin-top: 20px; color: var(--muted); }
  .pda-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    margin-top: 28px;
    padding: 14px 22px;
    border: 1px solid var(--navy);
    border-radius: var(--r-btn);
    color: var(--navy);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms, color 200ms;
  }
  .pda-link:hover { background: var(--navy); color: var(--on-dark); }

  .form-col { flex: 1.5 1 540px; min-width: 0; }
  .form[hidden] { display: none; }
  .form {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 24px;
  }
  .fld {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .fld--wide { grid-column: 1 / -1; }
  .fld input,
  .fld select,
  .fld textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-input);
    background: var(--surface);
    color: var(--ink);
    font-size: 16px;
    font-weight: 400;
  }
  .fld input:focus-visible,
  .fld select:focus-visible,
  .fld textarea:focus-visible {
    outline: none;
    border-color: var(--navy);
    box-shadow: 0 0 0 3px rgba(11, 42, 82, 0.18);
  }
  .attach-note { flex: 1 1 280px; font-size: var(--fs-small); line-height: 1.6; color: var(--muted); }
  .nojs {
    margin-top: 20px;
    padding: 16px 20px;
    border-left: 4px solid var(--navy);
    background: var(--surface-alt);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .form__foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-top: 8px;
  }
  .submit {
    min-height: 48px;
    padding: 17px 30px;
    border: 0;
    border-radius: var(--r-input);
    background: var(--navy);
    color: var(--on-dark);
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    transition: background-color 200ms;
  }
  .submit:hover { background: var(--deep); }

  /* ---------- Map ---------- */
  .map-section { padding-block: 96px; }
  .map {
    position: relative;
    aspect-ratio: 21 / 8;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-card-lg);
    overflow: hidden;
    background: color-mix(in srgb, var(--navy) 6%, var(--surface));
    color: var(--line-strong);
  }
  .map__art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .map__pin {
    position: absolute;
    left: 50%;
    top: 44%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translate(-50%, -100%);
  }
  .map__card {
    padding: 14px 18px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow-float);
    text-align: center;
    color: var(--ink);
  }
  .map__name { font-size: 17px; }
  .map__addr { margin-top: 4px; color: var(--muted); }
  .map__pin svg { margin-top: 8px; }

  .map__actions { position: absolute; right: 20px; bottom: 16px; display: flex; align-items: center; gap: 10px; }
  .map__show { display: inline-flex; align-items: center; gap: 12px; }
  .map__note { padding: 6px 10px; border-radius: var(--r-btn); background: var(--surface); color: var(--muted); }
  .map__btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 18px;
    border-radius: var(--r-btn);
    background: var(--navy);
    color: var(--on-dark);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: background-color 200ms;
  }
  .map__btn:hover { background: var(--deep); color: var(--on-dark); }
  .map__btn--light { background: var(--surface); color: var(--navy); border: 1px solid var(--navy); }
  .map__btn--light:hover { background: var(--navy); color: var(--on-dark); }

  .map :global(.map__frame) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map:global(.map--live) .map__art,
  .map:global(.map--live) .map__pin { display: none; }

  @media (max-width: 959px) {
    .desks { grid-template-columns: 1fr; padding-top: 40px; }
    .desk,
    .desk:first-child,
    .desk:last-child { padding: 28px 0 32px; }
    .desk + .desk { border-left: 0; }
    .map { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 599px) {
    .enquiry-section { padding-block: 64px; }
    .enquiry { gap: 32px; }
    .form { grid-template-columns: 1fr; gap: 16px; }
    .submit { width: 100%; }
    .map-section { padding-block: 48px; }
    .map { aspect-ratio: 3 / 4; border-radius: 14px; }
    .map__actions { left: 16px; right: 16px; bottom: 16px; flex-direction: column; align-items: stretch; }
    .map__show { flex-direction: column-reverse; align-items: stretch; gap: 8px; }
    .map__note { text-align: center; }
    .map__btn { justify-content: center; }
  }
</style>
