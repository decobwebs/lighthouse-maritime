---
// TEMPORARY (Stage 1): shows the overlay header on a photo, plus the footer. Delete before launch.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import heroHarbour from '../../assets/images/hero-harbour.jpg';
---
<BaseLayout
  title="Layout test: overlay header | Lighthouse Maritime Agency"
  description="Temporary page for checking the header, footer and phone action bar."
  header="overlay"
  noindex
>
  <section slot="hero" class="demo-hero on-dark">
    <Image
      src={heroHarbour}
      alt="A cargo vessel entering harbour at dusk past a quayside crane"
      class="demo-hero__img"
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="demo-hero__shade" aria-hidden="true"></div>
    <div class="container demo-hero__body">
      <p class="t-eyebrow" style="color: var(--red-soft)">Stage 1 test</p>
      <h1 class="t-h1">Overlay header <span class="dim">on a photo hero.</span></h1>
      <p class="t-lead demo-hero__lead">
        Check the utility bar, nav, Call 24/7 and Request a PDA. Below 960px the menu button opens the
        full-screen menu.
      </p>
      <p class="t-small demo-hero__lead"><a href="/test-layout/solid">See the solid header →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="t-h2">Content area <span class="dim">between header and footer.</span></h2>
      <p class="t-body demo-copy">
        On phones the action bar is fixed to the bottom. Scroll to the end: this paragraph and the footer
        must stay fully visible above it.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .demo-hero { position: relative; min-height: 640px; overflow: hidden; background: var(--deep); }
  .demo-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 55%;
  }
  .demo-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 18, 36, 0.72), rgba(6, 18, 36, 0) 200px),
      linear-gradient(90deg, rgba(6, 18, 36, 0.92) 0%, rgba(6, 18, 36, 0.68) 42%, rgba(6, 18, 36, 0.3) 75%, rgba(6, 18, 36, 0.2) 100%);
  }
  .demo-hero__body { position: relative; padding-top: 240px; padding-bottom: 80px; }
  .demo-hero__body h1 { margin-top: 16px; max-width: 760px; }
  .demo-hero__lead { margin-top: 20px; max-width: 580px; color: var(--on-dark-soft); }
  .demo-hero__lead a { color: var(--on-dark); }
  .demo-copy { margin-top: 20px; max-width: 640px; color: var(--muted); }

  @media (max-width: 959px) {
    .demo-hero__body { padding-top: 140px; }
  }
</style>
