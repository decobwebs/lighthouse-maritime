---
// Page shell: <head>, fonts, global styles, header, footer and the phone action bar.
//
// The header is fixed on every page (see Header.astro).
// header="overlay": transparent over the page's own photo hero until the visitor scrolls.
// header="solid":   solid from the start; the `hero` slot sits in a .bg-chart-dark masthead
//                   padded by the header height.
// Variable fonts: one file per family covers every weight we use (Manrope 500–800, Inter 400–600),
// about 73 KB in total instead of seven static files (~165 KB). Browsers fetch only the Latin file.
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
// Preloaded: both Latin files are needed for the first screen.
import manropeVar from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import interVar from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';

interface Props {
  title: string;
  description: string;
  header?: 'overlay' | 'solid';
  localBusiness?: boolean;
  noindex?: boolean;
}
const { title, description, header = 'solid', localBusiness = false, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before first paint: flag JS, and switch motion on only when JS runs and reduced motion is off.
         If the motion module hasn't started within 4s, a timer removes the flag so everything shows. -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        html.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          html.classList.add('motion-on');
          setTimeout(function () { if (!window.__motionReady) html.classList.remove('motion-on'); }, 4000);
        }
      })();
    </script>
    <link rel="preload" href={manropeVar} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interVar} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <SeoHead title={title} description={description} localBusiness={localBusiness} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header variant={header} />
    {header === 'overlay' ? (
      <div class="masthead masthead--overlay">
        <slot name="hero" />
      </div>
    ) : (
      <div class="masthead masthead--solid bg-chart-dark on-dark">
        <slot name="hero" />
      </div>
    )}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <MobileActionBar />

    <script>
      // Motion (DESIGN.md §7): GSAP + Lenis load as a separate module once the page has loaded and the
      // browser is idle, so they never compete with first paint or the hero photo (LCP).
      if (document.documentElement.classList.contains('motion-on')) {
        const start = () =>
          import('../scripts/motion/index').catch(() => document.documentElement.classList.remove('motion-on'));
        const whenIdle = () =>
          'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1200 }) : setTimeout(start, 200);
        if (document.readyState === 'complete') whenIdle();
        else addEventListener('load', whenIdle, { once: true });
      }

      // Assemble <Email> links in the browser so addresses never sit whole in the HTML.
      document.querySelectorAll<HTMLAnchorElement>('a[data-mailbox]').forEach((link) => {
        const domain = [...(link.dataset.domain ?? '')].reverse().join('');
        const at = String.fromCharCode(64);
        link.href = `mailto:${link.dataset.mailbox}${at}${domain}`;
        if (link.hasAttribute('data-breakable')) {
          link.replaceChildren(`${link.dataset.mailbox}${at}`, document.createElement('wbr'), domain);
        } else {
          link.textContent = `${link.dataset.mailbox}${at}${domain}`;
        }
      });
    </script>
  </body>
</html>

<style>
  .masthead--overlay { position: relative; }
  /* Room for the fixed header above solid heroes. */
  .masthead--solid { padding-top: var(--header-h); }

  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 12px 18px;
    border-radius: var(--r-btn);
    background: var(--surface);
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none; }

  main:focus { outline: none; }

  /* Room for the fixed action bar on phones: 50px buttons + 20px padding + 1px border. */
  @media (max-width: 599px) {
    body { padding-bottom: calc(71px + env(safe-area-inset-bottom)); }
  }
</style>
