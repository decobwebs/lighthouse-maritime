---
// Page shell: <head>, fonts, global styles, header, footer and the phone action bar.
//
// The header is fixed on every page (see Header.astro).
// header="overlay": transparent over the page's own photo hero until the visitor scrolls.
// header="solid":   solid from the start; the `hero` slot sits in a .bg-chart-dark masthead
//                   padded by the header height.
// Latin subsets only: the copy is English, so the other subsets are never needed.
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/manrope/latin-800.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '../styles/global.css';
// Preloaded: the faces used above the fold (headings, body).
import manrope700 from '@fontsource/manrope/files/manrope-latin-700-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';

interface Props {
  title: string;
  description: string;
  header?: 'overlay' | 'solid';
  localBusiness?: boolean;
  noindex?: boolean;
}
const { title, description, header = 'solid', localBusiness = false, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before first paint: flag JS, and switch scroll-reveal on only when JS runs and motion is allowed.
         If the reveal script never starts, a timer makes everything visible again. -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        html.classList.add('js');
        if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          html.classList.add('reveal-on');
          setTimeout(function () { if (!window.__revealReady) html.classList.remove('reveal-on'); }, 3000);
        }
      })();
    </script>
    <link rel="preload" href={manrope700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <SeoHead title={title} description={description} localBusiness={localBusiness} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header variant={header} />
    {header === 'overlay' ? (
      <div class="masthead masthead--overlay">
        <slot name="hero" />
      </div>
    ) : (
      <div class="masthead masthead--solid bg-chart-dark on-dark">
        <slot name="hero" />
      </div>
    )}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <MobileActionBar />

    <script>
      /* Scroll reveal (DESIGN.md §7): fade [data-reveal] elements up once, as they come into view.
         Elements revealed together are staggered 80ms apart, in document order. */
      if (document.documentElement.classList.contains('reveal-on')) {
        (window as unknown as { __revealReady: boolean }).__revealReady = true;
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.filter((e) => e.isIntersecting);
            visible.forEach((entry, i) => {
              const el = entry.target as HTMLElement;
              el.style.setProperty('--reveal-delay', `${Math.min(i, 5) * 80}ms`);
              el.classList.add('is-revealed');
              observer.unobserve(el);
            });
          },
          { threshold: 0.15 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      }

      // Assemble <Email> links in the browser so addresses never sit whole in the HTML.
      document.querySelectorAll<HTMLAnchorElement>('a[data-mailbox]').forEach((link) => {
        const domain = [...(link.dataset.domain ?? '')].reverse().join('');
        const at = String.fromCharCode(64);
        link.href = `mailto:${link.dataset.mailbox}${at}${domain}`;
        if (link.hasAttribute('data-breakable')) {
          link.replaceChildren(`${link.dataset.mailbox}${at}`, document.createElement('wbr'), domain);
        } else {
          link.textContent = `${link.dataset.mailbox}${at}${domain}`;
        }
      });
    </script>
  </body>
</html>

<style>
  .masthead--overlay { position: relative; }
  /* Room for the fixed header above solid heroes. */
  .masthead--solid { padding-top: var(--header-h); }

  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 12px 18px;
    border-radius: var(--r-btn);
    background: var(--surface);
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none; }

  main:focus { outline: none; }

  /* Room for the fixed action bar on phones: 50px buttons + 20px padding + 1px border. */
  @media (max-width: 599px) {
    body { padding-bottom: calc(71px + env(safe-area-inset-bottom)); }
  }
</style>
