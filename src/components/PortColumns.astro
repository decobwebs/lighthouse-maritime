---
// Port cards (DESIGN.md §6, on .bg-chart-light): four white cards; Apapa (head office) has a red marker.
import { PORT_REGIONS } from '../data/site';

interface Props {
  /** Region heading level: 3 under a section h2 (Home), 2 directly under the page h1 (/ports). */
  headingLevel?: 2 | 3;
}
const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---
<ul role="list" class="ports">
  {PORT_REGIONS.map((r) => (
    <li class="port-card" data-card>
      <div class="port-card__head">
        <Heading class="t-eyebrow port-card__region">{r.region}</Heading>
        <p class:list={['t-micro', 'port-card__note', { 'port-card__note--hq': r.note === 'Head office' }]}>{r.note}</p>
      </div>
      <ul role="list" class="port-card__list">
        {r.ports.map((port) => (
          <li class="t-h5 port-card__port">
            <span class:list={['marker', { 'marker--hq': port === 'Apapa' }]} aria-hidden="true"></span>
            {port}{port === 'Apapa' && <span class="visually-hidden"> (head office)</span>}
          </li>
        ))}
      </ul>
    </li>
  ))}
</ul>

<style>
  .ports {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .port-card {
    padding: 28px;
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .port-card__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .port-card__region { font-size: 12px; color: var(--navy); }
  .port-card__note { color: var(--muted); text-align: right; }
  .port-card__note--hq { color: var(--red); font-weight: 600; }

  .port-card__list { margin-top: 18px; }
  .port-card__port { display: flex; align-items: center; gap: 12px; padding-block: 11px; }
  .marker {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--navy);
  }
  .marker--hq { background: var(--red); border-color: var(--red); }

  @media (max-width: 1099px) {
    .ports { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    .ports { grid-template-columns: 1fr; gap: 12px; }
    .port-card { padding: 20px 22px; }
    .port-card__list { margin-top: 10px; }
    .port-card__port { padding-block: 8px; font-size: 16px; }
  }
</style>
