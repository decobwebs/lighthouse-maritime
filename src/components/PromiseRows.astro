---
// Promise tiles (DESIGN.md §6, Home About): mist tiles with the number in a white square.
interface Props {
  items: { title: string; text: string }[];
  /** Heading level for the tile titles. */
  headingLevel?: 'h3' | 'h4';
}
const { items, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---
<ol role="list" class="tiles">
  {items.map((item, i) => (
    <li class="tile" data-reveal>
      <span class="tile__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div>
        <Heading class="t-h4 tile__title">{item.title}</Heading>
        <p class="t-small tile__text">{item.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .tiles { display: flex; flex-direction: column; gap: 14px; }
  .tile {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 16px;
    padding: 20px 22px;
    border-radius: 12px;
    background: var(--mist);
  }
  .tile__num {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    color: var(--red);
  }
  .tile__title { font-size: min(var(--fs-h4), 20px); }
  .tile__text { margin-top: 4px; color: var(--muted); }

  @media (max-width: 599px) {
    .tile { grid-template-columns: 40px 1fr; gap: 12px; padding: 16px; }
    .tile__num { width: 36px; height: 36px; font-size: 13px; }
  }
</style>
