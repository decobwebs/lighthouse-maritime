---
// Home photo hero (DESIGN.md §5 Photo heroes, 01-home-desktop-v4): photo + three overlays, badge,
// display H1, lead, two buttons, the PDA starter and the Operations desk board. Sits under the
// fixed, transparent header. Entrance, lighthouse beam, drift and scroll-out are in
// src/scripts/motion/hero.ts (DESIGN.md §7); without JS or with reduced motion it is fully static.
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import QuickPdaPanel from './QuickPdaPanel.astro';
import DeskBoard from './DeskBoard.astro';
import heroHarbour from '../assets/images/hero-harbour.jpg';
import { HERO_WIDTHS, HERO_QUALITY } from '../data/hero';
---
<section class="hero on-dark" aria-labelledby="hero-title" data-hero>
  <Picture
    src={heroHarbour}
    formats={['avif', 'webp']}
    widths={HERO_WIDTHS}
    quality={HERO_QUALITY}
    sizes="100vw"
    alt="A cargo vessel entering harbour at dusk past a quayside crane"
    class="hero__img"
    pictureAttributes={{ class: 'hero__picture' }}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__shade hero__shade--side" aria-hidden="true"></div>
  <div class="hero__shade hero__shade--top" aria-hidden="true"></div>
  <div class="hero__shade hero__shade--bottom" aria-hidden="true"></div>
  <div class="hero__dim hero__dim--intro" data-hero-dim aria-hidden="true"></div>
  <div class="hero__dim hero__dim--scroll" data-hero-dim-scroll aria-hidden="true"></div>
  <div class="hero__beam" aria-hidden="true"><div class="hero__cone" data-hero-cone></div></div>

  <div class="container hero__body" data-hero-body>
    <p class="t-micro hero__badge" data-hero-item><span class="hero__badge-tag">Certified</span>NPA · NIMASA · NOGIC JQS</p>
    <h1 class="t-display hero__title" id="hero-title" data-hero-title>
      Ship agency you can rely on, <span class="dim">at every Nigerian port.</span>
    </h1>
    <p class="t-lead hero__lead" data-hero-item>
      Port agency, husbandry, clearance and vessel supply, with accurate PDAs, clear updates and one
      accountable contact from arrival to sailing.
    </p>
    <div class="hero__actions" data-hero-item>
      <span class="hero__cta">
        <span class="hero__ring" aria-hidden="true"></span>
        <span class="hero__ring" aria-hidden="true"></span>
        <Button href="/request-a-pda" arrow class="hero__cta-btn" data-hero-cta>Request a PDA</Button>
      </span>
      <Button href="/services" variant="secondary-dark">Explore services</Button>
    </div>
  </div>

  <div class="container hero__panel" data-hero-panel>
    <QuickPdaPanel />
  </div>

  <div class="container hero__desk">
    <DeskBoard />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--deep);
  }
  .hero__picture,
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* 2% wider than the hero so the ambient drift never shows an edge.
     Capped at 92% of the screen height and faded at its lower edge: the hero's bottom is solid navy
     anyway, and a photo that fills the whole viewport is ignored by Chrome as an LCP candidate. */
  .hero__picture {
    width: 102%;
    height: min(100%, 92vh);
    height: min(100%, 92svh);
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
  }
  .hero__img { object-fit: cover; object-position: 60% 40%; }

  /* Dim layers: the entrance starts darker; the scroll-out darkens slightly. Clear by default. */
  .hero__dim { position: absolute; inset: 0; background: var(--deep); opacity: 0; pointer-events: none; }

  /* Lighthouse beam: a soft warm cone rotated about a point just off the right edge (sized in JS). */
  .hero__beam { position: absolute; inset: 0; overflow: hidden; pointer-events: none; mix-blend-mode: screen; }
  .hero__cone {
    position: absolute;
    left: 0;
    top: 0;
    width: 10px;
    height: 10px;
    opacity: 0;
    background: conic-gradient(
      from -7deg at 50% 50%,
      rgba(255, 236, 200, 0) 0deg,
      rgba(255, 236, 200, 0.2) 7deg,
      rgba(255, 236, 200, 0) 14deg,
      rgba(255, 236, 200, 0) 360deg
    );
    /* Fades only far beyond the headline and button. */
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 0%, #000 55%, transparent 90%);
            mask-image: radial-gradient(circle at 50% 50%, #000 0%, #000 55%, transparent 90%);
    will-change: transform, opacity;
  }

  /* Request a PDA: pulse rings (outside the button) and a one-off light shine (inside it). */
  .hero__cta { position: relative; display: inline-flex; }
  .hero__ring {
    position: absolute;
    inset: 0;
    border-radius: var(--r-btn);
    border: 2px solid rgba(240, 138, 128, 0.7);
    opacity: 0;
    pointer-events: none;
  }
  .hero__cta :global(.hero__cta-btn) { position: relative; overflow: hidden; }
  .hero__cta :global(.hero__cta-btn)::after {
    content: '';
    position: absolute;
    inset: -20% auto -20% 0;
    width: 45%;
    background: linear-gradient(105deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.45) 50%, rgba(255, 255, 255, 0) 100%);
    transform: translateX(-160%) skewX(-12deg);
    pointer-events: none;
  }
  .hero__cta :global(.hero__cta-btn.is-shining)::after { animation: hero-shine 0.9s var(--ease-out) 1; }
  @keyframes hero-shine {
    from { transform: translateX(-160%) skewX(-12deg); }
    to { transform: translateX(360%) skewX(-12deg); }
  }

  /* Entrance start states (only while motion is on). */
  :global(html.motion-on) .hero__img { transform: scale(1.08); filter: brightness(0.8); }
  :global(html.motion-on) .hero__dim--intro { opacity: 0.35; }
  :global(html.motion-on) .hero__title { visibility: hidden; }
  :global(html.motion-on) [data-hero-item] { opacity: 0; transform: translateY(16px); }
  :global(html.motion-on) .hero__panel :global(.qp) { opacity: 0; transform: translateY(32px); }

  .hero__shade { position: absolute; pointer-events: none; }
  .hero__shade--side {
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 18, 36, 0.92) 0%, rgba(6, 18, 36, 0.66) 42%, rgba(6, 18, 36, 0.28) 75%, rgba(6, 18, 36, 0.18) 100%);
  }
  .hero__shade--top {
    inset: 0 0 auto 0;
    height: 180px;
    background: linear-gradient(180deg, rgba(6, 18, 36, 0.7), rgba(6, 18, 36, 0));
  }
  /* Fades into solid navy behind the PDA starter and the desk board. */
  .hero__shade--bottom {
    inset: auto 0 0 0;
    height: 520px;
    background: linear-gradient(0deg, var(--deep) 0%, rgba(7, 26, 51, 0.92) 40%, rgba(7, 26, 51, 0) 100%);
  }

  /* Header is 88px; content starts 96px below it. */
  .hero__body { position: relative; padding-top: calc(var(--header-h) + 96px); }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 8px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 40px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--on-dark-soft);
  }
  .hero__badge-tag {
    padding: 3px 9px;
    border-radius: 20px;
    background: var(--red);
    color: var(--on-dark);
    font-weight: 600;
  }
  .hero__title { margin-top: 26px; max-width: 820px; }
  .hero__lead { margin-top: 28px; max-width: 580px; color: var(--on-dark-soft); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 40px; }

  .hero__panel { position: relative; margin-top: 84px; }
  .hero__desk { position: relative; margin-top: 20px; padding-bottom: 80px; }

  @media (max-width: 959px) {
    .hero__body { padding-top: calc(var(--header-h) + 72px); }
    .hero__panel { margin-top: 56px; }
  }

  /* Phone: one vertical overlay and stacked full-width buttons (02-home-phone). */
  @media (max-width: 599px) {
    .hero__img { object-position: 62% 50%; }
    .hero__shade--side {
      background: linear-gradient(180deg, rgba(6, 18, 36, 0.75) 0%, rgba(6, 18, 36, 0.55) 35%, rgba(6, 18, 36, 0.92) 70%, var(--deep) 100%);
    }
    .hero__shade--top,
    .hero__shade--bottom { display: none; }
    .hero__body { padding-top: calc(var(--header-h) + 52px); }
    .hero__badge { padding: 6px 12px 6px 6px; gap: 8px; }
    .hero__title { margin-top: 22px; line-height: 1.06; letter-spacing: -0.03em; }
    .hero__lead { margin-top: 18px; }
    .hero__actions { flex-direction: column; gap: 10px; margin-top: 28px; }
    .hero__actions :global(.btn) { width: 100%; border-radius: var(--r-input); }
    .hero__cta { display: flex; width: 100%; }
    .hero__panel { margin-top: 40px; }
    .hero__desk { margin-top: 14px; padding-bottom: 48px; }
  }
</style>
