---
// Home photo hero (DESIGN.md §5 Photo heroes): photo + three overlays, badge, display H1,
// lead, two buttons and the quick PDA panel. Sits under the overlay header.
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import QuickPdaPanel from './QuickPdaPanel.astro';
import heroHarbour from '../assets/images/hero-harbour.jpg';
import { HERO_WIDTHS } from '../data/hero';
---
<section class="hero on-dark" aria-labelledby="hero-title">
  <Picture
    src={heroHarbour}
    formats={['avif', 'webp']}
    widths={HERO_WIDTHS}
    sizes="100vw"
    alt="A cargo vessel entering harbour at dusk past a quayside crane"
    class="hero__img"
    pictureAttributes={{ class: 'hero__picture' }}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__shade hero__shade--side" aria-hidden="true"></div>
  <div class="hero__shade hero__shade--top" aria-hidden="true"></div>
  <div class="hero__shade hero__shade--bottom" aria-hidden="true"></div>

  <div class="container hero__body">
    <p class="t-micro hero__badge"><span class="hero__badge-tag">Certified</span>NPA · NIMASA · NOGIC JQS</p>
    <h1 class="t-display hero__title" id="hero-title">
      Ship agency you can rely on, <span class="dim">at every Nigerian port.</span>
    </h1>
    <p class="t-lead hero__lead">
      Port agency, husbandry, clearance and vessel supply, with accurate PDAs, clear updates and one
      accountable contact from arrival to sailing.
    </p>
    <div class="hero__actions">
      <Button href="/request-a-pda" arrow>Request a PDA</Button>
      <Button href="/services" variant="secondary-dark">Explore services</Button>
    </div>
  </div>

  <div class="container hero__panel">
    <QuickPdaPanel />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 880px;
    overflow: hidden;
    background: var(--deep);
  }
  .hero__picture,
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__img { object-fit: cover; object-position: 60% 55%; }

  .hero__shade { position: absolute; pointer-events: none; }
  .hero__shade--side {
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 18, 36, 0.92) 0%, rgba(6, 18, 36, 0.68) 42%, rgba(6, 18, 36, 0.3) 75%, rgba(6, 18, 36, 0.2) 100%);
  }
  .hero__shade--top {
    inset: 0 0 auto 0;
    height: 200px;
    background: linear-gradient(180deg, rgba(6, 18, 36, 0.72), rgba(6, 18, 36, 0));
  }
  .hero__shade--bottom {
    inset: auto 0 0 0;
    height: 360px;
    background: linear-gradient(0deg, rgba(6, 18, 36, 0.92), rgba(6, 18, 36, 0));
  }

  /* Header overlay is ~128px tall (utility bar + main bar); content starts 88px below it. */
  .hero__body { position: relative; padding-top: 216px; }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px 8px 10px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 40px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--on-dark-soft);
  }
  .hero__badge-tag {
    padding: 3px 8px;
    border-radius: 20px;
    background: var(--red);
    color: var(--on-dark);
    font-weight: 600;
  }
  .hero__title { margin-top: 26px; max-width: 820px; }
  .hero__lead { margin-top: 28px; max-width: 580px; color: var(--on-dark-soft); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 40px; }

  .hero__panel { position: relative; margin-top: 84px; padding-bottom: 48px; }

  @media (max-width: 959px) {
    .hero { min-height: 0; }
    .hero__body { padding-top: 160px; }
    .hero__panel { margin-top: 56px; }
  }

  /* Phone: one vertical overlay and stacked full-width buttons (02-home-phone). */
  @media (max-width: 599px) {
    .hero__img { object-position: 62% 50%; }
    .hero__shade--side {
      background: linear-gradient(180deg, rgba(6, 18, 36, 0.75) 0%, rgba(6, 18, 36, 0.55) 35%, rgba(6, 18, 36, 0.92) 100%);
    }
    .hero__shade--top,
    .hero__shade--bottom { display: none; }
    .hero__body { padding-top: 120px; }
    .hero__badge { padding: 6px 12px 6px 6px; gap: 8px; }
    .hero__title { margin-top: 22px; line-height: 1.06; letter-spacing: -0.03em; }
    .hero__lead { margin-top: 18px; }
    .hero__actions { flex-direction: column; gap: 10px; margin-top: 28px; }
    .hero__actions :global(.btn) { width: 100%; border-radius: var(--r-input); }
    .hero__panel { margin-top: 40px; padding-bottom: 28px; }
  }
</style>
