---
// Buttons from DESIGN.md §6. `primary` (red) is for the main action only.
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary-dark' | 'secondary-light' | 'dark';
  size?: 'md' | 'sm';
  arrow?: boolean;
  class?: string;
  [attr: string]: unknown;
}
const { href, variant = 'primary', size = 'md', arrow = false, class: className, ...rest } = Astro.props;
---
<a href={href} class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...rest}>
  <slot />
  {arrow && <Icon name="arrow" strokeWidth={2} />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 17px 30px;
    border-radius: var(--r-btn);
    border: 1px solid transparent;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 200ms, color 200ms, border-color 200ms;
  }
  .btn--sm {
    min-height: 44px;
    padding: 11px 18px;
    font-size: 14.5px;
  }

  .btn--primary { background: var(--red); color: var(--on-dark); }
  .btn--primary:hover { background: var(--red-hover); color: var(--on-dark); }

  .btn--secondary-dark {
    background: transparent;
    color: var(--on-dark);
    border-color: rgba(255, 255, 255, 0.35);
    font-weight: 500;
  }
  .btn--secondary-dark:hover { background: rgba(255, 255, 255, 0.16); color: var(--on-dark); }
  .btn--secondary-dark:focus-visible { outline-color: var(--on-dark); }

  .btn--secondary-light {
    background: transparent;
    color: var(--navy);
    border-color: var(--navy);
    font-weight: 500;
  }
  .btn--secondary-light:hover { background: var(--navy); color: var(--on-dark); }

  .btn--dark { background: var(--navy); color: var(--on-dark); }
  .btn--dark:hover { background: var(--deep); color: var(--on-dark); }
</style>
