---
// Official Lighthouse mark (white, public/logo-mark-white.svg) + wordmark, for dark surfaces.
// The mark is an <img> so its ~4 KB of path data is downloaded once and cached, not inlined on every page.
// Width and height attributes match the viewBox ratio (264.8 × 328.5 ≈ 0.81), so nothing shifts while it loads.
interface Props {
  /** md: header (mark 40px tall). sm: footer and mobile menu (mark 36px tall). */
  size?: 'md' | 'sm';
  class?: string;
}
const { size = 'md', class: className } = Astro.props;
const markHeight = size === 'md' ? 40 : 36;
const markWidth = Math.round((markHeight * 264.8) / 328.5);
---
<a href="/" class:list={['logo', `logo--${size}`, className]} aria-label="Lighthouse Maritime Agency, home">
  <img
    class="logo__mark"
    src="/logo-mark-white.svg"
    alt=""
    width={markWidth}
    height={markHeight}
    decoding="async"
  />
  <span class="logo__text" aria-hidden="true">
    <span class="logo__name">Lighthouse</span>
    <span class="logo__sub">MARITIME AGENCY</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--on-dark);
    text-decoration: none;
    min-height: 44px;
  }
  .logo:hover { color: var(--on-dark); }
  .logo__mark { display: block; height: 40px; width: auto; flex: none; }
  .logo__text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.01em;
  }
  .logo__sub {
    margin-top: 3px;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--on-dark-soft);
  }

  .logo--sm { gap: 10px; }
  .logo--sm .logo__mark { height: 36px; }
  .logo--sm .logo__name { font-size: 16px; }
  .logo--sm .logo__sub { font-size: 9.5px; margin-top: 2px; }

  @media (max-width: 959px) {
    .logo:not(.logo--sm) { gap: 10px; }
    .logo:not(.logo--sm) .logo__name { font-size: 16px; }
    .logo:not(.logo--sm) .logo__sub { font-size: 9.5px; margin-top: 2px; }
  }
</style>
