---
// White lighthouse mark + wordmark, for dark surfaces. Same drawing as public/logo-mark-white.svg.
interface Props {
  size?: 'md' | 'sm';
  class?: string;
}
const { size = 'md', class: className } = Astro.props;
---
<a href="/" class:list={['logo', `logo--${size}`, className]} aria-label="Lighthouse Maritime Agency, home">
  <svg class="logo__mark" viewBox="0 0 120 140" aria-hidden="true" focusable="false">
    <path d="M60 4 L60 12" stroke="#FFFFFF" stroke-width="5" />
    <path d="M46 24 L60 11 L74 24 Z" fill="#FFFFFF" />
    <rect x="49" y="24" width="22" height="15" fill="#FFFFFF" />
    <rect x="54" y="27" width="12" height="9" fill="var(--lamp)" />
    <rect x="42" y="39" width="36" height="5" fill="#FFFFFF" />
    <path d="M46 44 L74 44 L86 108 L34 108 Z" fill="#FFFFFF" />
    <path d="M4 106 C36 122 72 94 116 98 L116 110 C78 108 44 132 4 118 Z" fill="#FFFFFF" />
    <path d="M18 126 C52 132 82 112 116 114 L116 121 C84 120 54 140 18 133 Z" fill="var(--logo-red)" />
  </svg>
  <span class="logo__text" aria-hidden="true">
    <span class="logo__name">Lighthouse</span>
    <span class="logo__sub">MARITIME AGENCY</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--on-dark);
    text-decoration: none;
    min-height: 44px;
  }
  .logo:hover { color: var(--on-dark); }
  .logo__mark { width: 34px; height: 40px; flex: none; }
  .logo__text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.01em;
  }
  .logo__sub {
    margin-top: 3px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--on-dark-soft);
  }

  .logo--sm { gap: 10px; }
  .logo--sm .logo__mark { width: 26px; height: 30px; }
  .logo--sm .logo__name { font-size: 16px; }
  .logo--sm .logo__sub { font-size: 9.5px; margin-top: 2px; }

  @media (max-width: 959px) {
    .logo:not(.logo--sm) { gap: 10px; }
    .logo:not(.logo--sm) .logo__mark { width: 26px; height: 30px; }
    .logo:not(.logo--sm) .logo__name { font-size: 16px; }
    .logo:not(.logo--sm) .logo__sub { font-size: 9.5px; margin-top: 2px; }
  }
</style>
