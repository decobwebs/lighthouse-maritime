---
// Photo CTA banner (DESIGN.md §6): dark left-to-right overlay, copy left, buttons right.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image: ImageMetadata;
  alt: string;
  position?: string;
}
const { eyebrow, title, lead, image, alt, position = 'center' } = Astro.props;
---
<section class="cta">
  <div class="container">
    <div class="cta__card on-dark" data-wipe>
      <Picture
        src={image}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 1240px) 100vw, 1240px"
        alt={alt}
        class="cta__img"
        pictureAttributes={{ class: 'cta__picture' }}
        style={`object-position: ${position}`}
        loading="lazy"
        decoding="async"
      />
      <div class="cta__shade" aria-hidden="true"></div>
      <div class="cta__body">
        <div class="cta__copy">
          <p class="t-eyebrow cta__eyebrow">{eyebrow}</p>
          <h2 class="t-h2 cta__title">{title}</h2>
          {lead && <p class="t-lead cta__lead">{lead}</p>}
        </div>
        <div class="cta__actions">
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: 40px 120px; background: var(--surface); }
  .cta__card {
    position: relative;
    border-radius: var(--r-banner);
    overflow: hidden;
    background: var(--deep);
  }
  .cta__picture,
  .cta__img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cta__img { object-fit: cover; }
  .cta__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 18, 36, 0.95) 0%, rgba(6, 18, 36, 0.82) 50%, rgba(6, 18, 36, 0.45) 100%);
  }
  .cta__body {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 48px;
    padding: clamp(48px, 7vw, 96px);
  }
  .cta__copy { max-width: 640px; }
  .cta__eyebrow { color: var(--red-soft); }
  .cta__title { margin-top: 18px; }
  .cta__lead { margin-top: 20px; color: var(--on-dark-soft); }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 14px; }

  @media (max-width: 599px) {
    .cta { padding-block: 32px 48px; }
    .cta__card { border-radius: var(--r-card); }
    .cta__shade { background: rgba(6, 18, 36, 0.82); }
    .cta__body { padding: 36px 22px; gap: 24px; }
    .cta__title { margin-top: 12px; }
    .cta__lead { margin-top: 14px; }
    .cta__actions { flex-direction: column; width: 100%; gap: 10px; }
    .cta__actions :global(.btn) { width: 100%; border-radius: var(--r-input); }
  }
</style>
