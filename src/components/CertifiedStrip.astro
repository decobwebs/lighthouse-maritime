---
// "Certified by" strip (DESIGN.md §6): three equal logo slots, monochrome, ~48px tall. No CAC/RC here.
// Each logo has the authority's name under it (Inter 600, 14px, navy); a slot without a logo shows the name only.
import { Image } from 'astro:assets';
import { AUTHORITIES } from '../data/authorities';
---
<section class="cert" aria-labelledby="cert-label">
  <div class="container cert__inner">
    <p class="t-eyebrow cert__label" id="cert-label">Certified by</p>
    <ul role="list" class="cert__logos">
      {AUTHORITIES.map((a) => (
        <li class="cert__slot" data-card>
          {a.logo && <Image src={a.logo} alt="" format="webp" class="cert__logo" loading="lazy" />}
          <span class="cert__name">{a.short}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cert { background: var(--surface); }
  .cert__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px 64px;
    padding-top: 56px;
  }
  .cert__label { color: var(--label); }
  .cert__logos { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px 56px; }
  .cert__slot {
    width: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .cert__logo { width: auto; height: 48px; }
  .cert__name {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    color: var(--navy);
  }

  @media (max-width: 599px) {
    .cert__inner { gap: 16px; padding-top: 40px; }
    .cert__logos { gap: 12px 28px; }
    .cert__slot { width: 100px; gap: 8px; }
    .cert__logo { height: 40px; }
    .cert__name { font-size: 12.5px; }
  }
</style>
