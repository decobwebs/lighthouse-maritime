---
// Glass PDA starter in the Home hero (DESIGN.md §6 Quick PDA panel). No tabs: a plain GET form that
// carries vessel, port and eta to /request-a-pda, so it works without JS.
import { SITE, PORT_OPTIONS } from '../data/site';
---
<div class="qp on-dark" id="quick-pda">
  <div class="qp__main">
    <h2 class="qp__title">Request a PDA <span class="qp__sub">Itemised port cost estimate before arrival</span></h2>
    <form class="qp__form" action="/request-a-pda" method="get">
      <label class="qp__field qp__field--vessel t-micro">
        Vessel name or IMO
        <input type="text" name="vessel" placeholder="e.g. MV Atlantic Dawn / 9876543" autocomplete="off" />
      </label>
      <label class="qp__field qp__field--port t-micro">
        Port
        <select name="port">
          {PORT_OPTIONS.map((port) => <option value={port}>{port}</option>)}
        </select>
      </label>
      <label class="qp__field qp__field--eta t-micro">
        ETA
        <input type="date" name="eta" />
      </label>
      <button type="submit" class="qp__submit">Continue</button>
    </form>
  </div>

  <div class="qp__side">
    <p class="t-micro qp__side-kicker">Vessel arriving soon?</p>
    <p class="qp__side-title">Speak to our operations desk, day or night.</p>
    <a href={SITE.ops.tel} class="qp__call">{SITE.ops.phone}</a>
  </div>
</div>

<style>
  .qp {
    display: flex;
    flex-wrap: wrap;
    background: rgba(10, 26, 50, 0.6);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border: 1px solid var(--on-dark-line);
    border-radius: 14px;
    overflow: hidden;
  }
  .qp__main { flex: 999 1 640px; min-width: 0; padding: 26px 30px 30px; }

  .qp__title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }
  .qp__sub {
    margin-left: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--on-dark-muted);
  }

  .qp__form { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .qp__field { display: flex; flex-direction: column; gap: 8px; color: var(--on-dark-muted); }
  .qp__field--vessel { flex: 2 1 200px; }
  .qp__field--port { flex: 1 1 150px; }
  .qp__field--eta { flex: 1 1 140px; }
  .qp__field input,
  .qp__field select {
    min-height: 50px;
    width: 100%;
    padding: 14px 16px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-btn);
    background: rgba(255, 255, 255, 0.08);
    color: var(--on-dark);
    font-size: 15.5px;
    letter-spacing: 0;
    color-scheme: dark;
  }
  .qp__field select { padding-inline: 12px; }
  .qp__field select option { color: var(--ink); background: var(--surface); }
  .qp__field input::placeholder { color: var(--on-dark-muted); opacity: 1; }
  .qp__field input:focus-visible,
  .qp__field select:focus-visible {
    outline: 3px solid var(--on-dark);
    outline-offset: 2px;
    border-color: var(--on-dark);
  }
  .qp__submit {
    flex: 1 1 140px;
    align-self: flex-end;
    min-height: 50px;
    padding: 15px 20px;
    border: 0;
    border-radius: var(--r-btn);
    background: var(--red);
    color: var(--on-dark);
    font-size: 15.5px;
    font-weight: 600;
    transition: background-color 200ms;
  }
  .qp__submit:hover { background: var(--red-hover); }
  .qp__submit:focus-visible { outline-color: var(--on-dark); }

  .qp__side {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 10px;
    padding: 26px 30px;
    border-left: 1px solid var(--on-dark-line);
  }
  .qp__side-kicker { color: var(--on-dark-muted); }
  .qp__side-title {
    max-width: 240px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .qp__call {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    padding: 11px 18px;
    border-radius: var(--r-btn);
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.1);
    color: var(--on-dark);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 200ms;
  }
  .qp__call:hover { background: rgba(255, 255, 255, 0.16); color: var(--on-dark); }

  @media (max-width: 959px) {
    .qp__side { border-left: 0; border-top: 1px solid var(--on-dark-line); }
  }

  @media (max-width: 599px) {
    .qp { background: rgba(10, 26, 50, 0.62); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
    .qp__main { padding: 20px; }
    .qp__sub { display: block; margin: 2px 0 0; }
    .qp__form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 10px; margin-top: 16px; }
    .qp__field--vessel,
    .qp__submit { grid-column: 1 / -1; }
    .qp__field { gap: 6px; }
    .qp__field input,
    .qp__field select { font-size: 16px; padding: 13px 12px; border-radius: var(--r-input); }
    .qp__submit { font-size: 16px; border-radius: var(--r-input); margin-top: 2px; }
    .qp__side { display: none; }
  }
</style>
