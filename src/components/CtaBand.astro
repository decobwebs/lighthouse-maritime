---
// CTA card for inner pages (DESIGN.md §6): a .bg-chart-dark card inside a white section, so it never
// merges with the navy footer. Copy left, buttons right.
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---
<section class="band">
  <div class="container">
    <div class="band__card bg-chart-dark on-dark" data-reveal>
      <div class="band__copy">
        {eyebrow && <p class="t-eyebrow band__eyebrow">{eyebrow}</p>}
        <h2 class="t-h2 band__title">{title}</h2>
        {lead && <p class="t-lead band__lead">{lead}</p>}
      </div>
      <div class="band__actions"><slot /></div>
    </div>
  </div>
</section>

<style>
  .band { padding-block: 40px 120px; background: var(--surface); }
  .band__card {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 48px;
    padding: clamp(48px, 7vw, 88px);
    border-radius: var(--r-banner);
  }
  .band__copy { max-width: 640px; }
  .band__eyebrow { color: var(--red-soft); }
  .band__eyebrow + .band__title { margin-top: 16px; }
  .band__lead { margin-top: 18px; color: var(--on-dark-soft); }
  .band__actions { display: flex; flex-wrap: wrap; gap: 14px; }

  @media (max-width: 599px) {
    .band { padding-block: 32px 48px; }
    .band__card { padding: 36px 22px; gap: 24px; border-radius: var(--r-card); }
    .band__eyebrow + .band__title { margin-top: 12px; }
    .band__actions { flex-direction: column; width: 100%; gap: 10px; }
    .band__actions :global(.btn) { width: 100%; border-radius: var(--r-input); }
  }
</style>
