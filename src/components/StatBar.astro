---
// Four stats divided by vertical rules (DESIGN.md §6 Stats bar). 2×2 grid below 960px.
interface Stat {
  value: string;
  /** Red accent after the value, e.g. "+". */
  accent?: string;
  /** Smaller unit after the value, e.g. "hrs". */
  unit?: string;
  label: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---
<section class="stats" aria-label="Key facts">
  <dl class="container stats__grid">
    {stats.map((s) => (
      <div class="stats__item">
        <dt class="t-small stats__label">{s.label}</dt>
        <dd class="t-stat stats__value">
          {s.value}
          {s.accent && <span class="stats__accent">{s.accent}</span>}
          {s.unit && <span class="stats__unit">{s.unit}</span>}
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .stats { background: var(--surface); }
  .stats__grid { display: grid; grid-template-columns: repeat(4, 1fr); }

  /* Value first visually, label below; the <dt> stays first for screen readers. */
  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    padding: 44px 32px;
    border-right: 1px solid var(--line);
  }
  .stats__item:first-child { padding-left: 0; }
  .stats__item:last-child { padding-right: 0; border-right: 0; }

  .stats__value { color: var(--navy); }
  .stats__accent { color: var(--red); }
  .stats__unit { font-size: 0.5em; letter-spacing: 0; }
  .stats__label { color: var(--muted); }

  @media (max-width: 959px) {
    .stats__grid { grid-template-columns: 1fr 1fr; padding-inline: 0; }
    .stats__item,
    .stats__item:first-child,
    .stats__item:last-child { padding: 28px var(--gutter); }
    .stats__item:nth-child(odd) { border-right: 1px solid var(--line); }
    .stats__item:nth-child(even) { border-right: 0; }
    .stats__item:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 599px) {
    .stats__item { gap: 8px; }
  }
</style>
