---
// <head> meta: title, description, canonical, Open Graph, favicon and optional LocalBusiness JSON-LD.
import { getImage } from 'astro:assets';
import heroHarbour from '../assets/images/hero-harbour.jpg';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Add LocalBusiness structured data (Home and Contact only). */
  localBusiness?: boolean;
  noindex?: boolean;
}
const { title, description, localBusiness = false, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

// Default share image: a 1200×630 crop of the home hero.
const og = await getImage({
  src: heroHarbour,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center', // sharp accepts keywords only, not percentages
  format: 'jpg',
  quality: 80,
});
const ogImage = new URL(og.src, Astro.site ?? SITE.url).href;

const jsonLd = localBusiness
  ? {
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: SITE.legalName,
      url: SITE.url,
      logo: new URL('/logo-mark.svg', SITE.url).href,
      image: ogImage,
      telephone: SITE.ops.phone.replace(/\s/g, ''),
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address.street,
        addressLocality: SITE.address.area,
        addressRegion: SITE.address.city,
        addressCountry: 'NG',
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'operations',
          telephone: SITE.ops.phone.replace(/\s/g, ''),
          hoursAvailable: {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
            opens: '00:00',
            closes: '23:59',
          },
        },
        {
          '@type': 'ContactPoint',
          contactType: 'customer service',
          telephone: SITE.admin.phone.replace(/\s/g, ''),
        },
      ],
    }
  : null;
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="A cargo vessel entering harbour at dusk past a quayside crane" />
<meta property="og:locale" content="en_NG" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#071A33" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
