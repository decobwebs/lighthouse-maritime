---
// <head> meta: title, description, canonical, Open Graph, favicon and optional LocalBusiness JSON-LD.
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Add LocalBusiness structured data (Home and Contact only). */
  localBusiness?: boolean;
  noindex?: boolean;
}
const { title, description, localBusiness = false, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

// Share image: white mark and wordmark on navy, 1200×630 (public/og-image.png, made from public/logo-mark-white.svg).
const ogImage = new URL('/og-image.png', Astro.site ?? SITE.url).href;

const jsonLd = localBusiness
  ? {
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: SITE.legalName,
      url: SITE.url,
      logo: new URL('/logo-mark.svg', SITE.url).href,
      image: ogImage,
      telephone: SITE.ops.phone.replace(/\s/g, ''),
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address.street,
        addressLocality: SITE.address.area,
        addressRegion: SITE.address.city,
        addressCountry: 'NG',
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'operations',
          telephone: SITE.ops.phone.replace(/\s/g, ''),
          hoursAvailable: {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
            opens: '00:00',
            closes: '23:59',
          },
        },
      ],
    }
  : null;
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Lighthouse Maritime Agency logo: a white lighthouse on a navy background" />
<meta property="og:locale" content="en_NG" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#071A33" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
