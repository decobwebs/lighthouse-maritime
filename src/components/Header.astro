---
// Site header (DESIGN.md §6 Header). Fixed to the top on every page.
// overlay: starts transparent over a photo hero; turns solid after 40px of scroll.
// solid:   solid from the start (pages without a photo hero).
// After 40px it also shrinks 88 → 70px; it hides on scroll down (past 120px) and returns on scroll up.
// Shrinking and hiding use transforms only, so the header never causes layout shift.
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Email from './Email.astro';
import { SITE, NAV } from '../data/site';

interface Props {
  variant?: 'overlay' | 'solid';
}
const { variant = 'solid' } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
// On the PDA page itself, the red button would link to the current page; show the desk number instead.
const onPdaPage = isActive('/request-a-pda');
---
<header
  class:list={['site-header', 'on-dark', { 'is-solid': variant === 'solid' }]}
  data-site-header
  data-variant={variant}
>
  <div class="container bar">
    <Logo />

    <nav class="nav" aria-label="Main">
      <ul role="list" class="nav__list">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav__link', { 'is-active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="bar__actions">
      {onPdaPage ? (
        <a href={SITE.ops.tel} class="desk-pill">
          <span class="live-dot" aria-hidden="true"></span>24/7 · {SITE.ops.phone}
        </a>
      ) : (
        <>
          <a href={SITE.ops.tel} class="ghost-btn" aria-label={`Call the 24/7 operations desk, ${SITE.ops.phone}`}>
            <Icon name="phone" size={16} strokeWidth={1.9} />Call
          </a>
          <Button href="/request-a-pda" size="sm">Request a PDA</Button>
        </>
      )}
    </div>

    <!-- Without JS this link jumps to the footer, which lists every page. -->
    <a
      href="#site-footer"
      class="menu-btn"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <Icon name="menu" size={20} strokeWidth={2} />
    </a>
  </div>
</header>

<dialog id="site-menu" class="menu bg-chart-dark on-dark" aria-label="Menu">
  <div class="menu__top">
    <Logo size="sm" />
    <button type="button" class="menu-btn menu-btn--close" data-menu-close aria-label="Close menu" autofocus>
      <Icon name="close" size={20} strokeWidth={2} />
    </button>
  </div>

  <nav class="menu__nav" aria-label="Main menu">
    <ul role="list">
      {NAV.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['menu__link', { 'is-active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="menu__actions">
    {!onPdaPage && <Button href="/request-a-pda">Request a PDA</Button>}
    <Button href={SITE.ops.tel} variant="secondary-dark">Call 24/7 · {SITE.ops.phone}</Button>
  </div>

  <p class="menu__contact t-small">
    <Email mailbox={SITE.ops.mailbox} /><br />
    {SITE.address.short}
  </p>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menu = document.getElementById('site-menu') as HTMLDialogElement | null;

  /* ---------- Scroll states ---------- */
  if (header) {
    const alwaysSolid = header.dataset.variant === 'solid';
    let lastY = window.scrollY;
    let hidden = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      const scrolled = y > 40;
      header.classList.toggle('is-solid', alwaysSolid || scrolled);
      header.classList.toggle('is-compact', scrolled);

      // Never hide while the menu is open or focus is inside the header.
      const pinned = Boolean(menu?.open) || header.contains(document.activeElement);
      if (y < 120 || pinned) {
        hidden = false;
        lastY = y;
      } else if (y > lastY + 4) {
        hidden = true;
        lastY = y;
      } else if (y < lastY - 4) {
        hidden = false;
        lastY = y;
      }
      header.classList.toggle('is-hidden', hidden);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    header.addEventListener('focusin', () => {
      hidden = false;
      header.classList.remove('is-hidden');
    });
    update();
  }

  /* ---------- Phone menu: native <dialog> gives the focus trap, Esc and an inert page ---------- */
  const openers = document.querySelectorAll<HTMLAnchorElement>('[data-menu-open]');
  if (menu && typeof menu.showModal === 'function') {
    let lastOpener: HTMLElement | null = null;

    openers.forEach((opener) => {
      opener.setAttribute('role', 'button');
      opener.setAttribute('aria-expanded', 'false');
      opener.addEventListener('click', (event) => {
        event.preventDefault();
        lastOpener = opener;
        header?.classList.remove('is-hidden');
        menu.showModal();
        opener.setAttribute('aria-expanded', 'true');
      });
      opener.addEventListener('keydown', (event) => {
        if (event.key === ' ') {
          event.preventDefault();
          opener.click();
        }
      });
    });

    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    // Following a link closes the menu (needed for same-page anchors).
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.close()));
    // Keep Tab cycling inside the menu rather than escaping to the browser chrome.
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusable = menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    // A click on the backdrop area outside the content closes it too.
    menu.addEventListener('click', (event) => {
      if (event.target === menu) menu.close();
    });
    menu.addEventListener('close', () => {
      openers.forEach((opener) => opener.setAttribute('aria-expanded', 'false'));
      lastOpener?.focus();
    });
    // Close if the viewport grows past the phone/tablet range while open.
    window.matchMedia('(min-width: 960px)').addEventListener('change', (mq) => {
      if (mq.matches && menu.open) menu.close();
    });
  }
</script>

<style>
  /* ---------- Fixed header ---------- */
  .site-header {
    --shrink: 18px; /* 88 → 70px */
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--on-dark);
    background-color: transparent;
    transform: translateY(0);
    transition:
      transform 320ms var(--ease-out),
      background-color 250ms ease,
      box-shadow 250ms ease;
  }
  .site-header.is-solid { background-color: var(--deep); box-shadow: var(--shadow-header); }
  /* Shrink: slide the whole bar up and re-centre its content in the visible part. */
  .site-header.is-compact { transform: translateY(calc(var(--shrink) * -1)); }
  .site-header.is-compact .bar { transform: translateY(calc(var(--shrink) / 2)); }
  .site-header.is-hidden { transform: translateY(-100%); box-shadow: none; }

  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    transition: transform 320ms var(--ease-out);
  }

  .nav__list { display: flex; gap: 8px 34px; }
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--on-dark);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-top: 2px;
  }
  .nav__link:hover { color: var(--on-dark); border-bottom-color: var(--red); }
  .nav__link.is-active,
  .nav__link.is-active:hover { border-bottom-color: var(--red); }

  .bar__actions { display: flex; gap: 10px; align-items: center; }

  .ghost-btn,
  .desk-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 11px 16px;
    border-radius: var(--r-btn);
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: transparent;
    color: var(--on-dark);
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 200ms;
  }
  .ghost-btn:hover,
  .desk-pill:hover { background: rgba(255, 255, 255, 0.16); color: var(--on-dark); }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok-dot);
    flex: none;
  }

  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-input);
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08);
    color: var(--on-dark);
  }
  .menu-btn:hover { background: rgba(255, 255, 255, 0.16); color: var(--on-dark); }

  /* Compact desktop: tighter nav; the Call button returns at 1100px and up. */
  @media (max-width: 1199px) {
    .nav__list { gap: 8px 24px; }
    .bar { gap: 16px 24px; }
  }
  @media (max-width: 1099px) {
    .ghost-btn { display: none; }
  }

  /* Tablet and phone: logo + menu button only. */
  @media (max-width: 959px) {
    .site-header { --shrink: 8px; }
    .nav,
    .bar__actions { display: none; }
    .menu-btn { display: inline-flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .bar { transition: none; }
  }

  /* ---------- Full-screen menu ---------- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 12px var(--gutter) calc(32px + env(safe-area-inset-bottom));
    border: 0;
    color: var(--on-dark);
    overflow-y: auto;
    opacity: 0;
    transition: opacity 200ms, overlay 200ms allow-discrete, display 200ms allow-discrete;
  }
  .menu[open] { display: flex; flex-direction: column; opacity: 1; }
  @starting-style {
    .menu[open] { opacity: 0; }
  }
  .menu::backdrop { background: var(--deep); }

  .menu__top { display: flex; align-items: center; justify-content: space-between; }
  .menu-btn--close { display: inline-flex; }

  .menu__nav { margin-top: 40px; }
  .menu__nav li { border-bottom: 1px solid var(--on-dark-line); }
  .menu__link {
    display: flex;
    align-items: center;
    min-height: 60px;
    color: var(--on-dark);
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .menu__link:hover { color: var(--on-dark-soft); }
  .menu__link.is-active { color: var(--red-soft); }

  .menu__actions { display: grid; gap: 12px; margin-top: 32px; }
  .menu__contact { margin-top: 28px; color: var(--on-dark-muted); }
  .menu__contact :global(a) { color: var(--on-dark-soft); }
</style>

<style is:global>
  /* Stop the page behind the open menu from scrolling, without shifting the layout. */
  html { scrollbar-gutter: stable; }
  html:has(#site-menu[open]) { overflow: hidden; }
</style>
