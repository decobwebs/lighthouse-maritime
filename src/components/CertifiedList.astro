---
// Certification rows (DESIGN.md §6 Certified list). Registration numbers stay confidential:
// only the CAC RC number is shown.
const rows = [
  { name: 'Nigerian Ports Authority', sub: 'Shipping agent', badge: 'Certified' },
  { name: 'NIMASA', sub: 'Maritime services', badge: 'Certified' },
  { name: 'NCDMB · NOGIC JQS', sub: 'Oil and gas vendor', badge: 'Certified' },
  { name: 'Corporate Affairs Commission', sub: 'RC 7964161 · Incorporated 2024', badge: 'Registered' },
];
---
<ul role="list" class="certs">
  {rows.map((r) => (
    <li class="certs__row">
      <span class="certs__tick" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12l5 5 9-10" /></svg>
      </span>
      <div>
        <p class="t-h4 certs__name">{r.name}</p>
        <p class="t-small certs__sub">{r.sub}</p>
      </div>
      <span class="t-micro certs__badge">{r.badge}</span>
    </li>
  ))}
</ul>

<style>
  .certs { border-top: 2px solid var(--navy); }
  .certs__row {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 20px;
    align-items: center;
    padding-block: 26px;
    border-bottom: 1px solid var(--line);
  }
  .certs__tick {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--ok-bg);
    color: var(--ok);
  }
  .certs__name { font-size: 20px; }
  .certs__sub { margin-top: 4px; color: var(--muted); }
  .certs__badge {
    padding: 6px 12px;
    border-radius: 20px;
    background: var(--ok-bg);
    color: var(--ok);
    font-weight: 600;
  }

  @media (max-width: 599px) {
    .certs__row { grid-template-columns: 1fr auto; gap: 12px; padding-block: 18px; }
    .certs__tick { display: none; }
    .certs__name { font-size: 17px; }
    .certs__sub { font-size: 14px; }
    .certs__badge { padding: 5px 10px; }
  }
</style>
