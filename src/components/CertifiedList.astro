---
// Compliance cards (DESIGN.md §6): logo area, name, role and a "✓ Certified" pill.
// Registration numbers stay confidential: only the CAC RC number is shown (About only).
import { Image } from 'astro:assets';
import { AUTHORITIES } from '../data/authorities';

interface Props {
  /** Add the Corporate Affairs Commission card (About). */
  cac?: boolean;
  /** Card fill: mist on a white section (default), white on a mist section. */
  tone?: 'mist' | 'white';
}
const { cac = false, tone = 'mist' } = Astro.props;
---
<ul role="list" class:list={['certs', { 'certs--four': cac }]}>
  {AUTHORITIES.map((a) => (
    <li class:list={['card', `card--${tone}`]} data-reveal>
      <div class="card__logo">
        {a.logo ? (
          <Image src={a.logo} alt={a.logoAlt} format="webp" class="card__img" loading="lazy" />
        ) : (
          <span class="card__logo-text">{a.short}</span>
        )}
      </div>
      <p class="t-h5 card__name">{a.name}</p>
      <p class="t-small card__role">{a.role}</p>
      <span class="t-micro card__badge"><span aria-hidden="true">✓</span> Certified</span>
    </li>
  ))}
  {cac && (
    <li class:list={['card', `card--${tone}`]} data-reveal>
      <p class="t-h5 card__name card__name--first">Corporate Affairs Commission</p>
      <p class="t-small card__role">RC 7964161 · Incorporated 2024</p>
      <span class="t-micro card__badge"><span aria-hidden="true">✓</span> Registered</span>
    </li>
  )}
</ul>

<style>
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }
  .certs--four { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 26px;
    border-radius: var(--r-card);
  }
  .card--mist { background: var(--mist); }
  .card--white { background: var(--surface); }

  .card__logo {
    width: 100%;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-input);
    background: var(--surface);
  }
  .card--white .card__logo { background: var(--mist); }
  .card__img { width: auto; height: 36px; }
  .card__logo-text { font-family: var(--font-display); font-size: 14px; font-weight: 700; color: var(--label); }

  .card__name { margin-top: 18px; }
  .card__name--first { margin-top: 0; }
  .card__role { margin-top: 2px; color: var(--muted); }
  .card__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding: 6px 12px;
    border-radius: 20px;
    background: var(--ok-bg);
    color: var(--ok);
    font-weight: 600;
  }
  .card__role { margin-bottom: 14px; }

  @media (max-width: 599px) {
    .certs,
    .certs--four { grid-template-columns: 1fr; gap: 12px; }
    .card { padding: 22px; }
  }
</style>
